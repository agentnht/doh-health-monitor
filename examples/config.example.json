{
  "dns_listen_udp": "127.0.0.1:5355",
  "dns_listen_tcp": "127.0.0.1:5355",
  "http_listen": "127.0.0.1:18765",
  "reload_interval_seconds": 5,
  "dns_query_timeout_seconds": 15,
  "doh_timeout_seconds": 10,
  "dns_max_concurrent": 256,
  "health": {
    "interval_seconds": 1500,
    "timeout_seconds": 5,
    "failure_threshold": 1,
    "success_threshold": 1
  },
  "cache": {
    "enabled": true,
    "min_ttl_seconds": 5,
    "max_ttl_seconds": 300,
    "negative_ttl_seconds": 15,
    "max_entries": 8192,
    "max_bytes": 8388608
  },
  "upstreams": [
    {
      "id": "system-dns",
      "name": "System DNS (VPS)",
      "type": "system"
    },
    {
      "id": "geohide-eu",
      "name": "GeoHide EU"
    },
    {
      "id": "dagami",
      "name": "Dagami"
    },
    {
      "id": "comss-one",
      "name": "Comss.one"
    },
    {
      "id": "bezmezhau",
      "name": "Bezmezhau"
    },
    {
      "id": "zapret",
      "name": "Zapret"
    }
  ],
  "groups": [
    {
      "id": "google",
      "upstreams": [
        "system-dns",
        "geohide-eu",
        "dagami",
        "comss-one",
        "bezmezhau",
        "zapret"
      ]
    }
  ],
  "gemini_api": {
    "enabled": false,
    "required_for_group": false,
    "group_id": "google",
    "model": "gemini-3.8-flash",
    "interval_seconds": 1800,
    "key_file": "gemini_api_key",
    "prompt": "Reply with exactly OK.",
    "max_output_tokens": 8
  },
  "bootstrap_resolvers": [
    "1.1.1.1",
    "8.8.8.8"
  ],
  "local_hosts": {}
}
