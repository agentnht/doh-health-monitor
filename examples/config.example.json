{
  "dns_listen_udp": "127.0.0.1:5355",
  "dns_listen_tcp": "127.0.0.1:5355",
  "http_listen": "127.0.0.1:18765",
  "reload_interval_seconds": 5,
  "dns_query_timeout_seconds": 15,
  "doh_timeout_seconds": 10,
  "dns_max_concurrent": 256,
  "health": {
    "interval_seconds": 45,
    "timeout_seconds": 5,
    "failure_threshold": 3,
    "success_threshold": 5
  },
  "cache": {
    "enabled": true,
    "min_ttl_seconds": 5,
    "max_ttl_seconds": 300,
    "negative_ttl_seconds": 15,
    "max_entries": 8192
  },
  "upstreams": [
    {
      "id": "eu.geohide.ru",
      "name": "GeoHide EU"
    },
    {
      "id": "doh.dagami.ru",
      "name": "Dagami"
    },
    {
      "id": "dns.comss.one",
      "name": "Comss.one"
    },
    {
      "id": "dns.bezmezhau.com",
      "name": "Bezmezhau"
    },
    {
      "id": "dns.zapret.moe",
      "name": "Zapret"
    }
  ],
  "groups": [
    {
      "id": "default",
      "fake_dns": false,
      "domains": [],
      "upstreams": [
        "eu.geohide.ru",
        "doh.dagami.ru",
        "dns.comss.one",
        "dns.bezmezhau.com",
        "dns.zapret.moe"
      ],
      "checks": [
        {
          "domain": "example.com",
          "required": true
        }
      ]
    },
    {
      "id": "google",
      "fake_dns": true,
      "domains": [
        "google.com",
        "googleapis.com",
        "gstatic.com",
        "googleusercontent.com",
        "google.org",
        "googleadservices.com",
        "gemini.google.com",
        "generativelanguage.googleapis.com",
        "clients6.google.com",
        "jnn-pa.googleapis.com",
        "waa-pa.clients6.google.com",
        "google-analytics.com"
      ],
      "upstreams": [
        "eu.geohide.ru",
        "doh.dagami.ru",
        "dns.comss.one",
        "dns.bezmezhau.com",
        "dns.zapret.moe"
      ],
      "checks": [
        {
          "domain": "gemini.google.com",
          "http_url": "https://gemini.google.com/robots.txt",
          "required": true,
          "expected_status": [
            200
          ]
        },
        {
          "domain": "accounts.google.com",
          "http_url": "https://accounts.google.com/.well-known/openid-configuration",
          "required": true,
          "expected_status": [
            200
          ],
          "verify_oidc": true
        },
        {
          "domain": "aistudio.google.com",
          "required": false
        },
        {
          "domain": "alkalimakersuite-pa.clients6.google.com",
          "required": false
        },
        {
          "domain": "apis.google.com",
          "required": false
        },
        {
          "domain": "www.googletagmanager.com",
          "required": false
        },
        {
          "domain": "waa-pa.clients6.google.com",
          "required": false
        },
        {
          "domain": "console.cloud.google.com",
          "required": false
        },
        {
          "domain": "people-pa.clients6.google.com",
          "required": false
        },
        {
          "domain": "ln3.googleusercontent.com",
          "required": false
        },
        {
          "domain": "www.google-analytics.com",
          "required": false
        },
        {
          "domain": "content-autofill.googleapis.com",
          "required": false
        },
        {
          "domain": "play.google.com",
          "required": false
        },
        {
          "domain": "ssl.gstatic.com",
          "http_url": "https://ssl.gstatic.com/",
          "required": false,
          "expected_status": [
            200,
            301,
            302,
            403
          ]
        },
        {
          "domain": "www.googleapis.com",
          "http_url": "https://www.googleapis.com/",
          "required": false,
          "expected_status": [
            200,
            301,
            302,
            403
          ]
        }
      ]
    }
  ],
  "gemini_api": {
    "enabled": false,
    "required_for_group": false,
    "group_id": "google",
    "model": "gemini-3.8-flash",
    "interval_seconds": 1800,
    "key_file": "gemini_api_key",
    "prompt": "Reply with exactly OK.",
    "max_output_tokens": 8
  },
  "bootstrap_resolvers": [
    "1.1.1.1",
    "8.8.8.8"
  ],
  "local_hosts": {}
}
