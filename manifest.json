{
  "id": "doh-health-monitor",
  "name": "DoH DNS Proxy & Health Monitor",
  "version": "1.3.0",
  "apiVersion": 1,
  "type": "sidecar",
  "entrypoint": "bin/doh-health-monitor",
  "architectures": ["amd64"],
  "permissions": {
    "network": [],
    "panelApi": [],
    "bot": [],
    "sub": []
  },
  "events": [
    "xray.crash",
    "outbound.down",
    "outbound.up"
  ],
  "health": {
    "type": "http",
    "target": "http://127.0.0.1:18765/healthz",
    "intervalSeconds": 30,
    "timeoutSeconds": 3
  }
}
